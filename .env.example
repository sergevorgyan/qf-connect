# Server
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me-to-64-random-chars
# 32-byte key, base64, for encrypting CRM tokens at rest: openssl rand -base64 32
ENCRYPTION_KEY=
DATABASE_PATH=./qf-connect.db

# VoIP.ms (leave VOIPMS_MOCK=1 until the API is enabled and this server's IP is whitelisted)
VOIPMS_MOCK=1
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=

# Worker
CDR_POLL_SECONDS=60

# HubSpot public app (https://developers.hubspot.com) - redirect URL: $PUBLIC_URL/api/integrations/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
