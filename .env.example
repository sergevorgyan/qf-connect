# Server
PORT=3000
PUBLIC_URL=http://localhost:3000
# On the server: the portal address, e.g. DOMAIN=qf.lowcoster.us and PUBLIC_URL=https://qf.lowcoster.us
DOMAIN=
# The marketing website in ./website (defaults to quantumframe.lowcoster.us)
# SITE_DOMAIN=
SESSION_SECRET=change-me-to-64-random-chars
# 32-byte key, base64, for encrypting CRM tokens at rest: openssl rand -base64 32
ENCRYPTION_KEY=
DATABASE_PATH=./qf-connect.db

# Quantum Frame admin login, created by `npm run seed` in live mode
QF_ADMIN_EMAIL=
QF_ADMIN_PASSWORD=

# VoIP.ms (leave VOIPMS_MOCK=1 until the API is enabled and this server's IP is whitelisted).
# Swapping to a different VoIP.ms account later = change these two lines. See docs/connect-voipms.md.
VOIPMS_MOCK=1
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# The VoIP.ms account's own timezone (voicemail times use it)
VOIPMS_ACCOUNT_TIMEZONE=America/New_York

# Worker
CDR_POLL_SECONDS=60

# HubSpot public app (https://developers.hubspot.com) - redirect URL: $PUBLIC_URL/api/integrations/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
